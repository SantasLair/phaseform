{
 "description": "ctx.params is each attached script's defaults in list order (a later script wins a shared key), then the object's own params on top. Keys are not merged deeper than the top level. An object with no params and scripts that have no defaults still gets {}.",
 "paramDefaults": {
  "a.js": {
   "speed": 1,
   "color": "#ffcc33",
   "limits": {
    "min": 0,
    "max": 10
   }
  },
  "b.js": {
   "speed": 2,
   "mode": "fill"
  }
 },
 "modules": {
  "a.js": "return { create(o, scene, ctx) { o.setData('params', JSON.stringify(ctx.params)); } };",
  "b.js": "return { create(o, scene, ctx) { o.setData('seen', JSON.stringify(ctx.params)); } };",
  "c.js": "return { create(o, scene, ctx) { o.setData('params', JSON.stringify(ctx.params)); } };"
 },
 "scene": {
